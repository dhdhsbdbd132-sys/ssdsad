# Development uses SQLite and a local mailbox. Do not commit your actual .env.
ENVIRONMENT=development
# Omit SECRET_KEY in development: a random ignored .data/development.key is created.
# DATABASE_URL=sqlite:////absolute/path/todaygo.db
MAIL_BACKEND=file
# Real email delivery: MAIL_BACKEND=smtp. STARTTLS and certificate verification are required.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=TodayGo <noreply@example.com>
# A Google Web OAuth client needs this exact authorized callback URI.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_ISSUER=https://accounts.google.com
OAUTH_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/oauth/callback
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
ACCESS_MINUTES=15
REFRESH_DAYS=7
RATE_LIMIT=20
