# Development uses SQLite and a local mailbox. Do not commit your actual .env.
ENVIRONMENT=development
# Omit SECRET_KEY in development: a random ignored .data/development.key is created.
# DATABASE_URL=sqlite:////absolute/path/todaygo.db
MAIL_BACKEND=file
# Windows: CONFIGURE_EMAIL_WINDOWS.bat configures Mail.ru without sharing your password.
# Real Mail.ru delivery: MAIL_BACKEND=smtp, full mailbox login and an app password.
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURITY=ssl
# Other servers on port 587: SMTP_SECURITY=starttls. TLS verification stays enabled.
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=TodayGo <noreply@example.com>
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
ACCESS_MINUTES=15
REFRESH_DAYS=7
RATE_LIMIT=20
